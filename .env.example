# Все переменные опциональны — без .env приложение стартует с этими же значениями по умолчанию.

# Строка подключения к Postgres. Значение по умолчанию рассчитано на `docker compose up -d db`
# из docker-compose.yml в корне проекта.
TRACKER_DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5431/tracker

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
TRACKER_LOG_LEVEL=INFO

# Формат логов: console (человекочитаемый, для локальной разработки) или json (для продакшена)
TRACKER_LOG_FORMAT=console

# Хост и порт, на которых слушает uvicorn при запуске через `python main.py`
TRACKER_HOST=0.0.0.0
TRACKER_PORT=8000
